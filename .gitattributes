# Normalise to LF in the repository; .editorconfig sets end_of_line = lf.
* text=auto eol=lf

*.sln    text eol=crlf
*.ps1    text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf

*.sh     text eol=lf

# Native binaries and archives are never text.
*.dll    binary
*.so     binary
*.so.*   binary
*.dylib  binary
*.lib    binary
*.pdb    binary
*.png    binary
*.nupkg  binary
*.snupkg binary
*.snk    binary
