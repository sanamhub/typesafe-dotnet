<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only the sources listed here. A machine-wide feed, or the repository's own NuGet.Config
         one folder up, cannot shadow TypeSafeSharp. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      To try a build that is not on nuget.org yet, pack the SDK into a folder, uncomment
      this source and the matching mapping below, and set TypeSafeSharpVersion in
      Directory.Packages.props to 0.1.0-local.1:
        dotnet pack .. -c Release -o ../artifacts/packages -p:Version=0.1.0-local.1
    -->
    <!-- <add key="local" value="../artifacts/packages" /> -->
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!--
    <packageSource key="local">
      <package pattern="TypeSafeSharp" />
      <package pattern="TypeSafeSharp.*" />
    </packageSource>
    -->
  </packageSourceMapping>
</configuration>
