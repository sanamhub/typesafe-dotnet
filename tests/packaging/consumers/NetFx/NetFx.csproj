<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumes the packed TypeSafeSharp, never the project. verify-package.sh copies this folder
       to a temp directory, writes a NuGet.Config for the package folder and sets the version.
       No <Reference Include="System.Net.Http" />: AC-4.4 proves callers do not need one. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Consumer</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TypeSafeSharp" Version="$(TypeSafeSharpVersion)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="../Shared/StubServer.cs" />
  </ItemGroup>

</Project>
